NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# UUID of the only account allowed to enter. Also register it in tick_admins.
ADMIN_USER_ID=
# Set by npm run admin. You can leave these blank before the first setup.
ADMIN_USERNAME=
ADMIN_LOGIN_EMAIL=
# Optional: movie/TV search. Read Access Token from your TMDB API settings.
TMDB_READ_TOKEN=
# Optional: dedicated comics search. Without this, ISBN comics use Open Library.
COMIC_VINE_API_KEY=
# Required only by the local admin provisioning script; never used by the app.
SUPABASE_SECRET_KEY=
